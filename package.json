{
  "name": "@xiaoxing/api-provider-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Automate onboarding, model metadata enrichment, compatibility probing, and live model sync for third-party custom API providers in DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "llm",
    "custom-provider",
    "model-metadata",
    "xiaoxing"
  ],
  "author": {
    "name": "xiaoxing-nya",
    "email": "xiaoxing_bot@luoli.my"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "data",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node scripts/check-package.mjs",
    "test": "node tests/run.mjs",
    "build:catalog": "node scripts/build-catalog.mjs"
  }
}
